@"
@startuml
' === Стили ===
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam roundCorner 10
skinparam entity {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  FontColor #1B5E20
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F57F17
}

' === Сущности ===
entity "Сотрудник" as employee {
  * employee_full_name : TEXT <<PK>>
  --
  держит
}

entity "Инвентарь" as inventory {
  * inventory_num : INTEGER <<PK>>
  --
  name : TEXT
  status : TEXT
  current_holder : TEXT <<FK>>
  --
  возвращает
}

entity "Возврат" as return {
  * inventory_num : INTEGER <<FK, PK>>
  * return_date : TEXT <<PK>>
  --
  client_full_name : TEXT <<FK>>
  condition : TEXT
}

' === Связи ===
employee ||--o{ inventory : "держит"
employee ||--o{ return : "возвращает"
inventory ||--o{ return : "возвращается"

' === Примечания ===
note right of employee
  Один сотрудник может:
  • держать много единиц
  • возвращать много единиц
end note

note right of inventory
  Одна единица может:
  • быть у одного сотрудника
  • возвращаться много раз
end note

@enduml
"@ > docs\diagrams\er_diagram.puml